# ---------------------------------------------------------------------------
# All variables are optional. With none of them set the site builds and runs
# normally: no analytics script, no ad slot, canonical URLs pointing at
# localhost. Nothing here is a secret — these are public identifiers that ship
# to the browser by design. Never commit a real .env file.
# ---------------------------------------------------------------------------

# Canonical origin used for <link rel="canonical">, Open Graph URLs, sitemap.xml
# and robots.txt. Set this to the real production origin, without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://example.com

# Google Analytics 4 measurement ID (looks like G-XXXXXXXXXX).
# Leave empty to load no analytics at all. In the EEA/UK you must also add a
# consent mechanism before enabling this for real traffic.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google AdSense publisher ID (looks like ca-pub-0000000000000000).
# Leave empty to render no ad slots. Requires an approved AdSense account.
NEXT_PUBLIC_ADSENSE_CLIENT=
